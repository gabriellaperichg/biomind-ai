# Aplicação
BIOMIND_ENABLE_DOCS=1
BIOMIND_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
BIOMIND_LOG_LEVEL=INFO
BIOMIND_COOKIE_SECURE=false

# Privacidade: ative somente depois que BAAI/bge-m3 estiver no cache local.
BIOMIND_OFFLINE=1
BIOMIND_LOCAL_OLLAMA_ONLY=1
BIOMIND_ALLOWED_OLLAMA_HOSTS=localhost,127.0.0.1,::1,ollama
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.1:latest
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=550
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=900

# Índice e embeddings
BIOMIND_DB_DIR=biomind_db
BIOMIND_COLLECTION=casos
BIOMIND_EMBED_MODEL=BAAI/bge-m3
BIOMIND_EMBED_DEVICE=cpu
BIOMIND_EMBED_BATCH_SIZE=8

# Recuperação clínica conservadora
BIOMIND_TOP_K=4
BIOMIND_WINDOW=0
BIOMIND_WINDOW_SAME_SECTION_ONLY=1
BIOMIND_CANDIDATE_MULTIPLIER=8
BIOMIND_MAX_QUERY_VARIANTS=4
BIOMIND_MAX_RESULTS_PER_SOURCE=1
BIOMIND_MAX_CONTENT_SIMILARITY=0.86
BIOMIND_PISO_RELEVANCIA=0.35
BIOMIND_MIN_RERANK_SCORE=0.50
BIOMIND_MAX_CONTEXT_CHARS=8000
BIOMIND_REPAIR_UNSAFE_RESPONSE=1
BIOMIND_MAX_GENERATIONS=1
NUMEXPR_MAX_THREADS=12

# Chunking — exige executar novamente chunk.py e embed.py build
BIOMIND_CHUNK_MAX_CHARS=1200
BIOMIND_CHUNK_OVERLAP_CHARS=160
BIOMIND_MAX_UNIT_CHARS=1800
